
# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=YOUR_ACTUAL_NEO4J_PASSWORD

# Frontend and CORS
NEXT_PUBLIC_RESEARCH_API_URL=http://127.0.0.1:8001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Research engine
DEFAULT_DEVICE=auto
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
CLIP_MODEL_REVISION=3d74acf9a28c67741b2f4f2ea7635f0aaf6f0268
TRUST_MODE=heterogeneity

# Conformal decision mechanism
EVIDENTIAL_HEAD_PATH=
EVIDENTIAL_CALIBRATION_PATH=
CONFORMAL_ARTIFACT_PATH=/app/models/uca_conformal_v3.json

# Partial-OT trust weighting
OT_TRUST_TAU=50.0
OT_TRUST_K=100.0

# Resource limits
MAX_UPLOAD_BYTES=104857600
MAX_STATEMENT_BYTES=65536
MAX_STATEMENT_CHARS=20000
MAX_VIDEO_DURATION_SECONDS=300
MAX_VIDEO_FRAME_COUNT=200000
MAX_CONCURRENT_ANALYSIS=2

# Network
ALLOW_NON_LOOPBACK=0
RESEARCH_API_HOST=127.0.0.1

# Hugging Face
HF_TOKEN=

# Evidence storage
EVIDENCE_STORAGE_ROOT=evidence
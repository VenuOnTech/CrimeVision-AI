# Structured logging (see research-engine/logging_config.py).
LOG_LEVEL=INFO
LOG_JSON=1
LOG_FILE=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Best-effort persistence for the memory fallback.
# Survives a controlled process restart only. Not durable storage.
MEMORY_SNAPSHOT_PATH=memory_snapshot.json

# Frames sampled per video for the representative-frame selection.
VIDEO_SAMPLE_POINTS=9